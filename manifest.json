{
  "manifest_version": 3,
  "name": "GitHub Actions Staging Tag Copier",
  "version": "1.0.0",
  "description": "Adds a copy button next to the 'staging' title in GitHub Actions workflow runs to copy the build tag to clipboard.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://github.com/resumecompanion/*/actions/runs/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
